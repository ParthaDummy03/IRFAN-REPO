DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Leave DB_ENGINE=sqlite for the easiest local setup.
DB_ENGINE=sqlite

# For XAMPP MySQL, set DB_ENGINE=mysql and adjust these values.
# DB_ENGINE=mysql
# DB_NAME=taza_food_corner
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306

# Optional: supply a valid API key to enable model-powered chat.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
